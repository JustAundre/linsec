[apache-auth]
enabled  = true
port     = http,https
logpath  = %(apache_error_log)s
maxretry = 5
findtime = 10m
bantime  = 1h

[apache-badbots]
enabled  = true
port     = http,https
logpath  = %(apache_access_log)s
maxretry = 1
bantime  = 1d

[apache-noscript]
enabled  = true
port     = http,https
logpath  = %(apache_error_log)s
maxretry = 3
findtime = 10m
bantime  = 1h

[apache-overflows]
enabled  = true
port     = http,https
logpath  = %(apache_error_log)s
maxretry = 2
findtime = 10m
bantime  = 1h

[apache-nohome]
enabled  = true
port     = http,https
logpath  = %(apache_error_log)s
maxretry = 2
findtime = 10m
bantime  = 1h

[apache-botsearch]
enabled  = true
port     = http,https
logpath  = %(apache_error_log)s
maxretry = 2
findtime = 10m
bantime  = 1h

[apache-shellshock]
enabled  = true
port     = http,https
logpath  = %(apache_error_log)s
maxretry = 1
bantime  = 1d
